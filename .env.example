# Copy to .env and adjust. Only .env.example is committed, never .env.

# --- orders-service ---
SERVICE_NAME=orders-service
LOG_LEVEL=INFO
DEBUG=false

# --- PostgreSQL ---
DATABASE_DSN=postgresql://orders:orders@localhost:5432/orders
DATABASE_POOL_SIZE=10
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=30

# --- Kafka ---
# 29092 is the host listener advertised by the KRaft broker in docker-compose.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ORDERS_TOPIC=orders.events
KAFKA_INVENTORY_TOPIC=inventory.events
KAFKA_CONSUMER_GROUP=orders-service

# --- tests ---
TEST_DATABASE_DSN=postgresql+psycopg://orders:orders@localhost:5432/orders_test
TEST_REDIS_URL=redis://localhost:6379/1